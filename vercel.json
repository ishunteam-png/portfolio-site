{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/cv",        "destination": "/assets/pdf/Ishu_Singh_CV.pdf",        "permanent": false },
    { "source": "/portfolio", "destination": "/assets/pdf/Ishu_Singh_Portfolio.pdf", "permanent": false },
    { "source": "/mini-cv",   "destination": "/assets/pdf/Ishu_Singh_CV_Mini.pdf",   "permanent": false },
    { "source": "/github",    "destination": "https://github.com/ishunteam-png",     "permanent": false }
  ]
}
