{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }
      ]
    },
    {
      "source": "/pdf/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control",         "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    { "source": "/cv",        "destination": "/pdf/Ishu_Singh_CV.pdf",        "permanent": false },
    { "source": "/portfolio", "destination": "/pdf/Ishu_Singh_Portfolio.pdf", "permanent": false },
    { "source": "/mini-cv",   "destination": "/pdf/Ishu_Singh_CV_Mini.pdf",   "permanent": false },
    { "source": "/github",    "destination": "https://github.com/ishunteam-png", "permanent": false },
    { "source": "/projects/haimcore.html",    "destination": "/#proj-01", "permanent": true },
    { "source": "/projects/relief-guru.html", "destination": "/#proj-02", "permanent": true },
    { "source": "/projects/jalaram.html",     "destination": "/#proj-03", "permanent": true },
    { "source": "/projects/delhi.html",       "destination": "/#proj-04", "permanent": true },
    { "source": "/projects/kite-beach.html",  "destination": "/#proj-05", "permanent": true }
  ]
}
